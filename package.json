{
  "name": "bachat-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "generate-types": "node --env-file-if-exists=.env scripts/generate-types.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "migrate:dry-run": "node --env-file-if-exists=.env scripts/migrate.mjs --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@neon/neon-js": "^0.10.2",
    "@tanstack/react-query": "^5.105.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.10.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}

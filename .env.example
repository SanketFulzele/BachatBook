# ============================================================================
# Bachify environment configuration
# Copy to .env and fill in locally. NEVER commit .env or real credentials.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# DATABASE_URL is server-side only and must never be prefixed with VITE_.
# ============================================================================

# Application
VITE_APP_NAME=Bachify
VITE_APP_ENV=development

# Neon Managed Better Auth base URL, ending in /auth.
# Neon Console -> Auth -> Configuration -> Auth URL
# Example shape: https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
VITE_NEON_AUTH_URL=

# Neon Data API base URL, ending in /rest/v1.
# Neon Console -> Data API -> Project URL
# Example shape: https://<endpoint>.apirest.<region>.aws.neon.tech/<db>/rest/v1
VITE_NEON_DATA_API_URL=

# Server-side only. Direct (non-pooled) PostgreSQL connection string used by
# migration and type-generation tooling. Never read this from browser code and
# never rename it to VITE_DATABASE_URL.
DATABASE_URL=
